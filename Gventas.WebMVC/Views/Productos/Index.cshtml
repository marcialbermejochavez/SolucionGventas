@model IEnumerable<Gventas.WebMVC.Models.Producto>
@{ ViewBag.Title = "Listado de Productos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Mantenimiento de Productos (ADO.NET + Paginación)</h3>
    <a asp-action="Edit" class="btn btn-primary">+ Nuevo Producto</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m.codigo)</th>
            <th>@Html.DisplayNameFor(m => m.nombre)</th>
            <th>@Html.DisplayNameFor(m => m.unidad)</th>
            <th>@Html.DisplayNameFor(m => m.precio)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.codigo</td>
                <td>@item.nombre</td>
                <td>@item.unidad</td>
                <td>S/ @item.precio.ToString("F2")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.codigo" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.codigo" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar producto?');">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Paginación -->
<div class="mt-3">
    @for (int i = 0; i < (int)ViewBag.pags; i++)
    {
        <a asp-action="Index" asp-route-p="@i" class="btn @(i == (int)ViewBag.p ? "btn-dark" : "btn-outline-dark") btn-sm">
            @(i + 1)
        </a>
    }
</div>
