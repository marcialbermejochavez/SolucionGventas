<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Sistema Comercial Gventas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="container mt-3">
    <header class="bg-dark text-white p-3 rounded mb-3 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0">Sistema de Gestión Comercial - Gventas</h2>
            <small class="text-info">Arquitectura Distribuida ASP.NET Core</small>
        </div>
    </header>

    <nav class="nav nav-pills mb-4 bg-light p-2 rounded border">
        <a asp-controller="Clientes" asp-action="Index" class="nav-link">Clientes (Web API REST)</a>
        <a asp-controller="Productos" asp-action="Index" class="nav-link">Productos (ADO.NET)</a>
        <a asp-controller="Productos" asp-action="CatalogoGrpc" class="nav-link">Catálogo (gRPC)</a>
        <a asp-controller="Pedidos" asp-action="Crear" class="nav-link">Pedidos (Maestro-Detalle)</a>
    </nav>

    <!-- Alerta en tiempo real con SignalR -->
    <div id="alertaSignalR" class="alert alert-success d-none shadow-sm"></div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-primary alert-dismissible fade show">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <main class="pb-4">
        @RenderBody()
    </main>

    <footer class="mt-5 pt-3 border-top text-muted text-center">
        Sistema Comercial Gventas - ASP.NET Core MVC
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl("/notificacionHub").build();
        connection.on("RecibirNotificacion", function (mensaje) {
            const div = document.getElementById("alertaSignalR");
            div.textContent = "🔔 Tiempo Real (SignalR): " + mensaje;
            div.classList.remove("d-none");
        });
        connection.start().catch(err => console.error(err.toString()));
    </script>
</body>
</html>
